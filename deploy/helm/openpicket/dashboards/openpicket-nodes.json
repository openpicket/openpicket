{
 "uid": "openpicket-nodes",
 "title": "OpenPicket / Nodes",
 "tags": [
  "openpicket"
 ],
 "schemaVersion": 39,
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "timezone": "",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Data source"
   },
   {
    "name": "namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "label": "Namespace",
    "query": "label_values(openpicket_sink_latency_seconds_count, namespace)",
    "refresh": 2
   },
   {
    "name": "node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "label": "Node",
    "multi": true,
    "includeAll": true,
    "query": "label_values(openpicket_node_connected{namespace=\"$namespace\"}, node)",
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Nodes",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Connected nodes",
   "description": "",
   "targets": [
    {
     "expr": "max by (node, site) (openpicket_node_connected{namespace=\"$namespace\", node=~\"$node\"})",
     "refId": "A",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "endpoint": true,
       "pod": true,
       "service": true,
       "container": true,
       "instance": true,
       "namespace": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 8
   },
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Ban set elements",
   "description": "",
   "targets": [
    {
     "expr": "sum by (node, direction, family) (openpicket_node_ban_elements{namespace=\"$namespace\", node=~\"$node\"})",
     "legendFormat": "{{node}} {{direction}} {{family}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Decisions refused locally",
   "description": "Allowlist, local networks or set limits.",
   "targets": [
    {
     "expr": "max by (node) (openpicket_node_decisions_rejected{namespace=\"$namespace\", node=~\"$node\"})",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 12,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Port policy matches",
   "description": "",
   "targets": [
    {
     "expr": "sum by (node, rule) (rate(openpicket_node_policy_packets{namespace=\"$namespace\", node=~\"$node\"}[5m]))",
     "legendFormat": "{{node}} {{rule}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "pps",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "NFLOG records",
   "description": "",
   "targets": [
    {
     "expr": "sum by (node, prefix) (rate(openpicket_node_nflog_records{namespace=\"$namespace\", node=~\"$node\"}[5m]))",
     "legendFormat": "{{node}} {{prefix}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 12,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Log queue",
   "description": "",
   "targets": [
    {
     "expr": "max by (node) (openpicket_node_log_queue_bytes{namespace=\"$namespace\", node=~\"$node\"})",
     "legendFormat": "{{node}} used",
     "refId": "A"
    },
    {
     "expr": "max by (node) (openpicket_node_log_queue_capacity_bytes{namespace=\"$namespace\", node=~\"$node\"})",
     "legendFormat": "{{node}} capacity",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 12,
    "h": 8
   },
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Records sent / dropped",
   "description": "",
   "targets": [
    {
     "expr": "sum by (node) (rate(openpicket_node_log_sent_records{namespace=\"$namespace\", node=~\"$node\"}[5m]))",
     "legendFormat": "{{node}} sent",
     "refId": "A"
    },
    {
     "expr": "sum by (node) (rate(openpicket_node_log_agent_dropped_records{namespace=\"$namespace\", node=~\"$node\"}[5m]))",
     "legendFormat": "{{node}} dropped",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 12,
    "y": 25,
    "w": 12,
    "h": 8
   },
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Apply errors",
   "description": "",
   "targets": [
    {
     "expr": "max by (node, what) (openpicket_node_apply_error{namespace=\"$namespace\", node=~\"$node\"})",
     "legendFormat": "{{node}} {{what}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Policy version",
   "description": "",
   "targets": [
    {
     "expr": "max by (node) (openpicket_node_policy_version{namespace=\"$namespace\", node=~\"$node\"})",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "gridPos": {
    "x": 12,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  }
 ],
 "annotations": {
  "list": []
 }
}
